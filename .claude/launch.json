{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-l", "-c", "cd swimbuddz-frontend && npm run dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "analyzer",
      "runtimeExecutable": "/bin/zsh",
